# Backend environment variables example
# Copy values into your runtime environment / CloudBase environment variables.
# Do NOT commit real secrets.

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bank_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Runtime safety switches
# dev defaults enable both; prod defaults disable both unless explicitly set.
APP_SCHEMA_PATCH_ENABLED=false
APP_BOOTSTRAP_USERS_ENABLED=false

# Comma-separated production CORS allowlist.
APP_CORS_ALLOWED_ORIGINS=https://dev-4g1sv3870175b971-1411764939.tcloudbaseapp.com,https://api.bankaiscl.top,https://bank-admin-backend-239413-10-1411764939.sh.run.tcloudbase.com

# Tencent Hunyuan / CloudBase AI
# When cloudbase.ai.enabled=true in prod, use real values. Placeholder values
# such as your-secret-id / your-secret-key will fail startup validation.
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key
AI_SECRET_ID=your-secret-id
AI_SECRET_KEY=your-secret-key
